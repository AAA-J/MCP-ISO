{
  "_profile": "Startup Team",
  "_description": "Speed + shared reliability. Covers code, git, docs, API, DB inspection, and ops. Good default for most product teams moving fast.",
  "_maturity": "All Core or Recommended tier servers",
  "_setup": "Replace /path/to/MCP-ISO with your actual repo path. Replace placeholder tokens and connection strings with real values.",
  "_tradeoffs": "Broader surface area than Solo; ensure DB and API credentials are restricted to non-production or read-only scopes for safety.",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/your/project"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_your_github_personal_access_token"
      }
    },
    "app-docs": {
      "command": "/path/to/MCP-ISO/mcp-servers/application/app-docs/venv/bin/python",
      "args": [
        "/path/to/MCP-ISO/mcp-servers/application/app-docs/src/index.py"
      ],
      "env": {
        "BASE_DIR": "/path/to/your/project",
        "DOCS_DIR": "docs"
      }
    },
    "app-db-readonly": {
      "command": "/path/to/MCP-ISO/mcp-servers/application/app-db-readonly/venv/bin/python",
      "args": [
        "/path/to/MCP-ISO/mcp-servers/application/app-db-readonly/src/index.py"
      ],
      "env": {
        "DB_TYPE": "azure_sql",
        "DB_CONNECTION_STRING": "Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=yourDB;Uid=yourUser;Pwd=yourPassword;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"
      }
    },
    "app-api": {
      "command": "/path/to/MCP-ISO/mcp-servers/application/app-api/venv/bin/python",
      "args": [
        "/path/to/MCP-ISO/mcp-servers/application/app-api/src/index.py"
      ],
      "env": {
        "API_BASE_URL": "http://localhost:8000",
        "API_TYPE": "rest",
        "AUTH_TYPE": "bearer",
        "AUTH_TOKEN": "your_api_auth_token"
      }
    },
    "app-ops": {
      "command": "/path/to/MCP-ISO/mcp-servers/application/app-ops/venv/bin/python",
      "args": [
        "/path/to/MCP-ISO/mcp-servers/application/app-ops/src/index.py"
      ],
      "env": {
        "CICD_TYPE": "github_actions",
        "CICD_TOKEN": "ghp_your_github_personal_access_token",
        "CICD_OWNER": "your-github-org-or-username",
        "CICD_REPO": "your-repo-name"
      }
    }
  }
}
