# App-API Server Configuration

# API base URL
API_BASE_URL=http://localhost:8000

# API type: rest, graphql, fastapi, express
API_TYPE=rest

# Authentication type: bearer, api_key, basic
AUTH_TYPE=bearer

# Bearer token
AUTH_TOKEN=

# API key (if AUTH_TYPE=api_key)
API_KEY=
API_KEY_NAME=X-API-Key

# Basic auth (if AUTH_TYPE=basic)
AUTH_USERNAME=
AUTH_PASSWORD=

# Optional: Tool configuration file (YAML/JSON)
TOOL_CONFIG_FILE=
